-- Underwriting risk score 
-- Determining if an applicant should be approved or not based on their risk score 

-- Normalize region scores 
WITH region_approval_rates AS (
-- Step 1: Calculate approval rates
SELECT 
    region_code,
    ROUND(
      COUNT(*) FILTER (WHERE claim_status = 1) * 100.0 / COUNT(*),
      2
    ) AS approval_rate
  FROM insurance_claims_data
  GROUP BY region_code
),
region_scores AS (
  -- Step 2: Normalize using the approval rates from step 1
  SELECT 
    region_code,
    approval_rate,
    MIN(approval_rate) OVER () AS min_approval_rate,
    MAX(approval_rate) OVER () AS max_approval_rate,
    ROUND(
      ((approval_rate - MIN(approval_rate) OVER ()) / 
       NULLIF((MAX(approval_rate) OVER () - MIN(approval_rate) OVER ()), 0)) * 100,
      2
    ) AS region_score_normalized
  FROM region_approval_rates
),subscription_approval_rates AS (
  SELECT 
    CASE 
      WHEN subscription_length < 0.5 THEN '0-6 months'
      WHEN subscription_length < 1 THEN '6-12 months'
      WHEN subscription_length < 2 THEN '1-2 years'
      ELSE '2+ years'
    END AS subscription_bucket,
    ROUND(
      COUNT(*) FILTER (WHERE claim_status = 1) * 100.0 / COUNT(*),
      2
    ) AS approval_rate
  FROM insurance_claims_data
  GROUP BY subscription_bucket  -- ← Group by the CASE result, not raw subscription_length
),
subscription_scores AS (
  SELECT 
    subscription_bucket,
    approval_rate,
    MIN(approval_rate) OVER () AS min_approval_rate,
    MAX(approval_rate) OVER () AS max_approval_rate,
    ROUND(
      ((approval_rate - MIN(approval_rate) OVER ()) / 
       NULLIF((MAX(approval_rate) OVER () - MIN(approval_rate) OVER ()), 0)) * 100,
      2
    ) AS subscription_score_normalized
  FROM subscription_approval_rates
),age_approval_rates AS (
  SELECT 
    CASE 
      WHEN customer_age < 25 THEN 'Under 25'
      WHEN customer_age BETWEEN 25 AND 35 THEN '25-35'
      WHEN customer_age BETWEEN 35 AND 45 THEN '35-45'
      WHEN customer_age BETWEEN 45 AND 55 THEN '45-55'
      WHEN customer_age BETWEEN 55 AND 65 THEN '55-65'
      ELSE '65+'
    END AS age_bucket,
    ROUND(
      COUNT(*) FILTER (WHERE claim_status = 1) * 100.0 / COUNT(*),
      2
    ) AS approval_rate
  FROM insurance_claims_data
  GROUP BY age_bucket
),
age_scores AS (
  SELECT 
    age_bucket,
    approval_rate,
    ROUND(
      ((approval_rate - MIN(approval_rate) OVER ()) / 
       NULLIF((MAX(approval_rate) OVER () - MIN(approval_rate) OVER ()), 0)) * 100,
      2
    ) AS age_score_normalized
  FROM age_approval_rates
),vehicle_age_approval_rates AS (
  SELECT 
    CASE 
      WHEN vehicle_age < 3 THEN '0-3 years'
      WHEN vehicle_age < 6 THEN '3-6 years'
      WHEN vehicle_age < 10 THEN '6-10 years'
      ELSE '10+ years'
    END AS vehicle_age_bucket,
    ROUND(
      COUNT(*) FILTER (WHERE claim_status = 1) * 100.0 / COUNT(*),
      2
    ) AS approval_rate
  FROM insurance_claims_data
  GROUP BY vehicle_age_bucket
),
vehicle_age_scores AS (
  SELECT 
    vehicle_age_bucket,
    approval_rate,
    ROUND(
      ((approval_rate - MIN(approval_rate) OVER ()) / 
       NULLIF((MAX(approval_rate) OVER () - MIN(approval_rate) OVER ()), 0)) * 100,
      2
    ) AS vehicle_age_score_normalized
  FROM vehicle_age_approval_rates
),segment_approval_rates AS (
  SELECT 
    segment,
    ROUND(
      COUNT(*) FILTER (WHERE claim_status = 1) * 100.0 / COUNT(*),
      2
    ) AS approval_rate
  FROM insurance_claims_data
  GROUP BY segment
),
segment_scores AS (
  SELECT 
    segment,
    approval_rate,
    ROUND(
      ((approval_rate - MIN(approval_rate) OVER ()) / 
       NULLIF((MAX(approval_rate) OVER () - MIN(approval_rate) OVER ()), 0)) * 100,
      2
    ) AS segment_score_normalized
  FROM segment_approval_rates
),safety_approval_rates AS (
  SELECT 
    CASE 
      WHEN is_esc = 'Yes' AND is_brake_assist = 'Yes' THEN 'High Safety'
      WHEN is_esc = 'Yes' OR is_brake_assist = 'Yes' THEN 'Medium Safety'
      ELSE 'Low Safety'
    END AS safety_level,
    ROUND(
      COUNT(*) FILTER (WHERE claim_status = 1) * 100.0 / COUNT(*),
      2
    ) AS approval_rate
  FROM insurance_claims_data
  GROUP BY safety_level
),
safety_scores AS (
  SELECT 
    safety_level,
    approval_rate,
    ROUND(
      ((approval_rate - MIN(approval_rate) OVER ()) / 
       NULLIF((MAX(approval_rate) OVER () - MIN(approval_rate) OVER ()), 0)) * 100,
      2
    ) AS safety_score_normalized
  FROM safety_approval_rates
),
policy_risk_scores AS (SELECT   
i.policy_id,
    i.region_code,
    i.subscription_length,
    i.customer_age,
    i.vehicle_age,
    i.segment,
    i.claim_status,
	 r.region_score_normalized,
    s.subscription_score_normalized,
    a.age_score_normalized,
    v.vehicle_age_score_normalized,
    seg.segment_score_normalized,
    sf.safety_score_normalized,
	ROUND(
      (r.region_score_normalized * 0.25) +
      (s.subscription_score_normalized * 0.25) +
      (a.age_score_normalized * 0.25) +
      (v.vehicle_age_score_normalized * 0.15) +
      (seg.segment_score_normalized * 0.05) +
      (sf.safety_score_normalized * 0.05),
      2
    ) AS final_risk_score
	FROM insurance_claims_data i LEFT JOIN 
	region_scores r
	ON i.region_code = r.region_code
	LEFT JOIN 
	subscription_scores s
	  ON CASE 
         WHEN i.subscription_length < 0.5 THEN '0-6 months'
         WHEN i.subscription_length < 1 THEN '6-12 months'
         WHEN i.subscription_length < 2 THEN '1-2 years'
         ELSE '2+ years'
       END = s.subscription_bucket
	 LEFT JOIN 
	 age_scores a
	 ON CASE 
	WHEN i.customer_age < 25 THEN 'Under 25'
      WHEN i.customer_age BETWEEN 25 AND 35 THEN '25-35'
      WHEN i.customer_age BETWEEN 35 AND 45 THEN '35-45'
      WHEN i.customer_age BETWEEN 45 AND 55 THEN '45-55'
      WHEN i.customer_age BETWEEN 55 AND 65 THEN '55-65'
      ELSE '65+'
	  END = a.age_bucket
	 LEFT JOIN 
	 vehicle_age_scores v
	 ON CASE 
      WHEN i.vehicle_age < 3 THEN '0-3 years'
      WHEN i.vehicle_age < 6 THEN '3-6 years'
      WHEN i.vehicle_age < 10 THEN '6-10 years'
      ELSE '10+ years'
    END = v.vehicle_age_bucket
	 LEFT JOIN 
	 segment_scores seg ON i.segment=seg.segment
	 LEFT JOIN 
	 safety_scores sf ON 
	 CASE   WHEN i.is_esc = 'Yes' AND i.is_brake_assist = 'Yes' THEN 'High Safety'
      WHEN i.is_esc = 'Yes' OR i.is_brake_assist = 'Yes' THEN 'Medium Safety'
      ELSE 'Low Safety'
    END = sf.safety_level
	),final_table as(
	SELECT *, 
	CASE WHEN final_risk_score BETWEEN 9 AND 31 then 'C-Level Hight Risk'
	WHEN final_risk_score BETWEEN 31 AND 61 then 'B-Level Medium Risk'
	WHEN final_risk_score BETWEEN 61 AND 90 then 'A-Level Low Risk'
	end as policy_profile
	FROM policy_risk_scores)
	SELECT * FROM final_table;
	
